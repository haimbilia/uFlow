; $MODE = "UniformRegister"
; $NUM_SPI_PS_INPUT_CNTL = 2
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; $SAMPLER_VARS[0].name = "u_texture"
; $SAMPLER_VARS[0].type = "SAMPLER2D"
; $SAMPLER_VARS[0].location = 0
00 TEX: ADDR(64) CNT(1) VALID_PIX
    0 SAMPLE R1, R1.xy0x, t0, s0
01 ALU: ADDR(32) CNT(28)
    1 x: ADD R2.x, R1.x, -0.0627450980f
    2 y: ADD R2.y, R1.y, -0.5019607843f
    3 z: ADD R2.z, R1.z, -0.5019607843f
    4 x: MUL R2.x, R2.x, 1.1640625000f
    5 x: MULADD R3.x, R2.z, 1.5976562500f, R2.x
    6 y: MULADD R3.y, R2.y, -0.3906250000f, R2.x
    7 y: MULADD R3.y, R2.z, -0.8125000000f, R3.y
    8 z: MULADD R3.z, R2.y, 2.0156250000f, R2.x
    9 x: MAX R3.x, R3.x, 0.0f
    10 y: MAX R3.y, R3.y, 0.0f
    11 z: MAX R3.z, R3.z, 0.0f
    12 x: MIN R3.x, R3.x, 1.0f
    13 y: MIN R3.y, R3.y, 1.0f
    14 z: MIN R3.z, R3.z, 1.0f
    15 x: MUL R0.x, R0.x, R3.x
    16 y: MUL R0.y, R0.y, R3.y
    17 z: MUL R0.z, R0.z, R3.z
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
