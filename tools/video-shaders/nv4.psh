; $MODE = "UniformRegister"
; $NUM_SPI_PS_INPUT_CNTL = 2
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; $SAMPLER_VARS[0].name = "u_texture"
; $SAMPLER_VARS[0].type = "SAMPLER2D"
; $SAMPLER_VARS[0].location = 0
; $SAMPLER_VARS[1].name = "u_chroma"
; $SAMPLER_VARS[1].type = "SAMPLER2D"
; $SAMPLER_VARS[1].location = 1
00 TEX: ADDR(64) CNT(2) VALID_PIX
    0 SAMPLE R4, R1.xy0x, t1, s1
    1 SAMPLE R1, R1.xy0x, t0, s0
01 ALU: ADDR(32) CNT(27)
    2 x: ADD R2.x, R1.x, 0.0000000000f
    3 y: ADD R2.y, R4.x, -0.5019607843f
    4 z: ADD R2.z, R4.y, -0.5019607843f
    5 x: MUL R2.x, R2.x, 1.0000000000f
    6 x: MULADD R3.x, R2.z, 1.5742187500f, R2.x
    7 y: MULADD R3.y, R2.y, -0.1875000000f, R2.x
    8 y: MULADD R3.y, R2.z, -0.4687500000f, R3.y
    9 z: MULADD R3.z, R2.y, 1.8554687500f, R2.x
    10 x: MAX R3.x, R3.x, 0.0f
    11 y: MAX R3.y, R3.y, 0.0f
    12 z: MAX R3.z, R3.z, 0.0f
    13 x: MIN R3.x, R3.x, 1.0f
    14 y: MIN R3.y, R3.y, 1.0f
    15 z: MIN R3.z, R3.z, 1.0f
    16 x: MUL R0.x, R0.x, R3.x
    17 y: MUL R0.y, R0.y, R3.y
    18 z: MUL R0.z, R0.z, R3.z
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
